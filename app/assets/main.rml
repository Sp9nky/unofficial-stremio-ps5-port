<rml>
	<head>
		<title>Stremio</title>
		<link type="text/rcss" href="rml.rcss"/>
		<link type="text/rcss" href="css/theme.rcss"/>
		<link type="text/rcss" href="css/shell.rcss"/>
		<link type="text/rcss" href="css/board.rcss"/>
		<link type="text/rcss" href="css/browse.rcss"/>
		<link type="text/rcss" href="css/detail.rcss"/>
		<link type="text/rcss" href="css/settings.rcss"/>
		<link type="text/rcss" href="css/watch.rcss"/>
		<link type="text/rcss" href="css/overlays.rcss"/>
		<link type="text/rcss" href="css/motion.rcss"/>
	</head>
	<body data-model="app" data-class-watching="watching">

		<div id="app">
			<img id="app-bg" src="images/bg.png"/>

			<!-- ======================= Left navigation ======================= -->
			<div id="nav" data-class-focused="zone == 'nav'">
				<div class="nav-logo"><img src="icons/logo.png"/></div>
				<div class="nav-item" data-class-active="nav_sel == 0" data-class-selected="zone == 'nav' && nav_sel == 0">
					<img class="nav-o" src="icons/nav_board_o.png"/><img class="nav-s" src="icons/nav_board.png"/><div class="nav-label">Board</div>
				</div>
				<div class="nav-item" data-class-active="nav_sel == 1" data-class-selected="zone == 'nav' && nav_sel == 1">
					<img class="nav-o" src="icons/nav_discover_o.png"/><img class="nav-s" src="icons/nav_discover.png"/><div class="nav-label">Discover</div>
				</div>
				<div class="nav-item" data-class-active="nav_sel == 2" data-class-selected="zone == 'nav' && nav_sel == 2">
					<img class="nav-o" src="icons/nav_library_o.png"/><img class="nav-s" src="icons/nav_library.png"/><div class="nav-label">Library</div>
				</div>
				<div class="nav-item" data-class-active="nav_sel == 3" data-class-selected="zone == 'nav' && nav_sel == 3">
					<img class="nav-o" src="icons/nav_addons_o.png"/><img class="nav-s" src="icons/nav_addons.png"/><div class="nav-label">Addons</div>
				</div>
				<div class="nav-item" data-class-active="nav_sel == 4" data-class-selected="zone == 'nav' && nav_sel == 4">
					<img class="nav-o" src="icons/nav_settings_o.png"/><img class="nav-s" src="icons/nav_settings.png"/><div class="nav-label">Settings</div>
				</div>
			</div>

			<!-- ======================= Top bar ======================= -->
			<div id="topbar">
				<div class="topbar-spacer"/>
				<div class="topbar-busy" data-if="busy">
					<span class="busy-dot busy-dot1"/><span class="busy-dot busy-dot2"/><span class="busy-dot busy-dot3"/>
				</div>
				<div id="searchbar" data-class-selected="zone == 'searchbox'">
					<span class="search-text" data-if="search_query != '' && view == 'search'">{{search_query}}</span>
					<span class="search-placeholder" data-if="search_query == '' || view != 'search'">Search or paste link</span>
					<img class="search-icon" src="icons/search.png"/>
				</div>
				<div class="topbar-clock">{{clock}}</div>
			</div>

			<!-- ======================= Board ======================= -->
			<div class="page" data-if="view == 'home'">
				<div class="banner" data-if="banner != ''">{{banner}}</div>
				<div id="home-board" class="board">
					<div class="board-row" data-for="row, ri : home_rows">
						<div class="row-head" data-class-current="zone == 'content' && ri == home_row">
							<div class="row-title">{{row.title}}</div>
							<div class="see-all" data-if="row.see_all">
								<img class="key-icon" src="icons/square.png" data-if="zone == 'content' && ri == home_row"/>SEE ALL
							</div>
						</div>
						<div class="strip" data-attr-id="row.dom_id">
							<div class="card" data-for="card, ci : row.cards"
							     data-class-selected="zone == 'content' && ri == home_row && ci == home_col">
								<div class="poster">
									<img class="poster-img" data-if="card.image != ''" data-attr-src="card.image"/>
									<div class="poster-ph" data-if="card.image == ''">{{card.initials}}</div>
									<div class="poster-badge" data-if="card.badge != ''">{{card.badge}}</div>
									<div class="card-progress" data-if="card.progress != '0%'"><div class="card-progress-bar" data-style-width="card.progress"/></div>
								</div>
								<div class="card-title">{{card.title}}</div>
							</div>
							<div class="row-message" data-if="row.message != ''">{{row.message}}</div>
						</div>
					</div>
					<div class="page-empty" data-if="home_rows.size == 0">Loading your addons...</div>
				</div>
			</div>

			<!-- ======================= Search results ======================= -->
			<div class="page" data-if="view == 'search'">
				<div class="page-heading" data-if="search_status != ''">{{search_status}}</div>
				<div id="search-board" class="board">
					<div class="board-row" data-for="row, ri : search_rows">
						<div class="row-head" data-class-current="zone == 'content' && ri == search_row">
							<div class="row-title">{{row.title}}</div>
						</div>
						<div class="strip" data-attr-id="row.dom_id">
							<div class="card" data-for="card, ci : row.cards"
							     data-class-selected="zone == 'content' && ri == search_row && ci == search_col">
								<div class="poster">
									<img class="poster-img" data-if="card.image != ''" data-attr-src="card.image"/>
									<div class="poster-ph" data-if="card.image == ''">{{card.initials}}</div>
								</div>
								<div class="card-title">{{card.title}}</div>
							</div>
							<div class="row-message" data-if="row.message != ''">{{row.message}}</div>
						</div>
					</div>
				</div>
			</div>

			<!-- ======================= Discover ======================= -->
			<div class="page" data-if="view == 'discover'">
				<div class="filters">
					<div class="filter-chip" data-for="c : disc_chips"
					     data-class-selected="zone == 'filters' && it_index == disc_chip">
						<span class="filter-value">{{c.value}}</span>
						<img class="filter-caret" src="icons/chevron_down.png"/>
					</div>
				</div>
				<div class="discover-body">
					<div id="disc-grid" class="grid">
						<div class="grid-card" data-for="card : disc_cards"
						     data-class-selected="zone == 'content' && it_index == disc_sel">
							<div class="poster">
								<img class="poster-img" data-if="card.image != ''" data-attr-src="card.image"/>
								<div class="poster-ph" data-if="card.image == ''">{{card.initials}}</div>
							</div>
							<div class="card-title">{{card.title}}</div>
						</div>
						<div class="page-empty" data-if="disc_status != ''">{{disc_status}}</div>
					</div>
					<div class="preview" data-if="dp_name != ''">
						<img class="preview-still" data-if="dp_still != ''" data-attr-src="dp_still"/>
						<div class="preview-still preview-still-ph" data-if="dp_still == ''"/>
						<img class="preview-logo" data-if="dp_logo != ''" data-attr-src="dp_logo"/>
						<div class="preview-name" data-if="dp_logo == ''">{{dp_name}}</div>
						<div class="meta-row">
							<span class="meta-item" data-if="dp_runtime != ''">{{dp_runtime}}</span>
							<span class="meta-item" data-if="dp_year != ''">{{dp_year}}</span>
							<span class="imdb" data-if="dp_imdb != ''"><span class="imdb-logo">IMDb</span>{{dp_imdb}}</span>
						</div>
						<div class="preview-genres" data-if="dp_genres != ''">{{dp_genres}}</div>
						<div class="preview-desc">{{dp_desc}}</div>
						<div class="preview-hint" data-if="zone == 'content'"><img class="key-icon" src="icons/cross.png"/>Show</div>
					</div>
				</div>
			</div>

			<!-- ======================= Library ======================= -->
			<div class="page" data-if="view == 'library'">
				<div class="filters">
					<div class="filter-chip" data-for="c : lib_chips"
					     data-class-selected="zone == 'filters' && it_index == lib_chip">
						<span class="filter-value">{{c.value}}</span>
						<img class="filter-caret" src="icons/chevron_down.png"/>
					</div>
				</div>
				<div id="lib-grid" class="grid grid-7">
					<div class="grid-card" data-for="card : lib_cards"
					     data-class-selected="zone == 'content' && it_index == lib_sel">
						<div class="poster">
							<img class="poster-img" data-if="card.image != ''" data-attr-src="card.image"/>
							<div class="poster-ph" data-if="card.image == ''">{{card.initials}}</div>
							<div class="card-progress" data-if="card.progress != '0%'"><div class="card-progress-bar" data-style-width="card.progress"/></div>
						</div>
						<div class="card-title">{{card.title}}</div>
					</div>
					<div class="page-empty" data-if="lib_status != ''">{{lib_status}}</div>
				</div>
			</div>

			<!-- ======================= Addons ======================= -->
			<div class="page" data-if="view == 'addons'">
				<div class="page-title">Addons</div>
				<div id="addon-list" class="list">
					<div class="addon-tile" data-for="a : addon_rows"
					     data-class-selected="zone == 'content' && it_index == addon_sel">
						<div class="addon-top">
							<img class="addon-logo" data-if="a.logo != ''" data-attr-src="a.logo"/>
							<div class="addon-logo addon-logo-ph" data-if="a.logo == ''">{{a.initials}}</div>
							<div class="addon-head">
								<div class="addon-name">{{a.name}}</div>
								<div class="addon-version">{{a.version}}<span class="addon-local" data-if="a.local">LOCAL</span></div>
							</div>
						</div>
						<div class="addon-types">{{a.types}}</div>
						<div class="addon-desc">{{a.desc}}</div>
					</div>
				</div>
				<div class="page-footer">
					<span class="hint"><img class="key-icon" src="icons/square.png"/>Reload addons</span>
				</div>
			</div>

			<!-- ======================= Settings ======================= -->
			<div class="page" data-if="view == 'settings'">
				<div class="page-title">Settings</div>
				<div id="settings-list" class="list">
					<div class="setting-row" data-for="s : s_rows"
					     data-class-selected="zone == 'content' && it_index == s_sel">
						<div class="setting-main">
							<div class="setting-label">{{s.label}}</div>
							<div class="setting-hint" data-if="s.hint != ''">{{s.hint}}</div>
						</div>
						<div class="setting-value">{{s.value}}</div>
					</div>
				</div>
			</div>

			<!-- ======================= Detail ======================= -->
			<div id="detail" data-if="view == 'detail'">
				<img id="detail-bg" data-if="d_background != ''" data-attr-src="d_background"/>
				<img id="detail-shade" src="images/shade_detail.png"/>

				<div id="detail-info">
					<img id="detail-logo" data-if="d_logo != ''" data-attr-src="d_logo"/>
					<div id="detail-name" data-if="d_logo == ''">{{d_name}}</div>
					<div class="meta-row">
						<span class="meta-item" data-if="d_runtime != ''">{{d_runtime}}</span>
						<span class="meta-item" data-if="d_year != ''">{{d_year}}</span>
						<span class="imdb" data-if="d_imdb != ''"><span class="imdb-logo">IMDb</span>{{d_imdb}}</span>
					</div>
					<div class="detail-section" data-if="d_genres != ''">
						<div class="section-label">GENRES</div>
						<div class="section-value">{{d_genres}}</div>
					</div>
					<div class="detail-section" data-if="d_cast != ''">
						<div class="section-label">CAST</div>
						<div class="section-value">{{d_cast}}</div>
					</div>
					<div class="detail-section" data-if="d_directors != ''">
						<div class="section-label">DIRECTORS</div>
						<div class="section-value">{{d_directors}}</div>
					</div>
					<div class="detail-section" data-if="d_description != ''">
						<div class="section-label">SUMMARY</div>
						<div class="section-desc">{{d_description}}</div>
					</div>
					<div class="detail-resume" data-if="d_resume != ''"><img src="icons/play.png"/>{{d_resume}}</div>
				</div>

				<div id="detail-panel">
					<!-- Seasons + episodes -->
					<div class="panel-body" data-if="d_series && d_zone != 'streams'">
						<div id="season-bar" data-class-focused="d_zone == 'seasons'">
							<img class="season-arrow" src="icons/chevron_left.png"/>
							<span class="season-label">{{d_season_label}}</span>
							<img class="season-arrow" src="icons/chevron_right.png"/>
						</div>
						<div id="episode-list" class="list">
							<div class="episode-row" data-for="e : d_episodes"
							     data-class-selected="d_zone == 'episodes' && it_index == d_episode_sel"
							     data-class-watched="e.watched">
								<div class="episode-thumb">
									<img data-if="e.thumb != ''" data-attr-src="e.thumb"/>
								</div>
								<div class="episode-text">
									<div class="episode-title">{{e.title}}</div>
									<div class="episode-sub" data-if="e.sub != ''">{{e.sub}}</div>
								</div>
								<img class="episode-check" data-if="e.watched" src="icons/check.png"/>
							</div>
							<div class="panel-empty" data-if="d_episodes.size == 0">Loading episodes...</div>
						</div>
					</div>

					<!-- Streams -->
					<div class="panel-body" data-if="!d_series || d_zone == 'streams'">
						<div class="panel-head">
							<img class="panel-back" data-if="d_series" src="icons/chevron_left.png"/>
							<span class="panel-title">{{d_streams_title}}</span>
						</div>
						<div id="stream-list" class="list">
							<div class="stream-row" data-for="st : d_streams"
							     data-class-selected="d_zone == 'streams' && it_index == d_stream_sel">
								<div class="stream-left">
									<div class="stream-name">{{st.name}}</div>
									<div class="stream-addon">{{st.addon}}</div>
								</div>
								<div class="stream-desc">{{st.desc}}</div>
								<img class="stream-play" src="icons/play.png"/>
							</div>
						</div>
						<div class="panel-status" data-if="d_streams_status != ''">{{d_streams_status}}</div>
					</div>
				</div>

				<div class="detail-footer">
					<span class="hint" data-if="d_zone == 'streams' && d_pick_res"><img class="key-icon" src="icons/cross.png"/>Choose quality</span>
					<span class="hint" data-if="d_zone == 'streams' && !d_pick_res"><img class="key-icon" src="icons/cross.png"/>Play</span>
					<span class="hint" data-if="d_zone == 'streams' && !d_pick_res"><img class="key-icon" src="icons/square.png"/>Play with server transcoding</span>
					<span class="hint" data-if="d_zone == 'streams' && !d_pick_res"><img class="key-icon" src="icons/circle.png"/>Qualities</span>
					<span class="hint" data-if="d_zone == 'episodes'"><img class="key-icon" src="icons/cross.png"/>Streams</span>
					<span class="hint" data-if="d_zone == 'episodes'"><img class="key-icon" src="icons/l1.png"/><img class="key-icon" src="icons/r1.png"/>Season</span>
					<span class="hint" data-if="d_zone == 'episodes'"><img class="key-icon" src="icons/triangle.png"/>Mark watched</span>
					<span class="hint"><img class="key-icon" src="icons/circle.png"/>Back</span>
				</div>
			</div>
		</div>

		<!-- ======================= Player ======================= -->

		<div id="subtitles" data-if="watching && w_sub_rml != ''"
		     data-class-sub-s="w_sub_size == 'sub-s'" data-class-sub-m="w_sub_size == 'sub-m'"
		     data-class-sub-l="w_sub_size == 'sub-l'" data-class-raised="info_visible">
			<span class="sub-text" data-rml="w_sub_rml"></span>
		</div>

		<div id="buffering" data-if="watching && w_buffering">
			<div class="buffer-dots"><span class="busy-dot busy-dot1"/><span class="busy-dot busy-dot2"/><span class="busy-dot busy-dot3"/></div>
			<div class="buffer-text">{{w_buffer_text}}</div>
			<div class="tstats" data-if="t_visible">
				<div class="tstats-row">
					<div class="tstats-cell"><div class="tstats-label">Peers</div><div class="tstats-value">{{t_peers}}</div></div>
					<div class="tstats-cell"><div class="tstats-label">Speed</div><div class="tstats-value">{{t_speed}}</div></div>
					<div class="tstats-cell"><div class="tstats-label">Completed</div><div class="tstats-value">{{t_progress}}</div></div>
				</div>
			</div>
		</div>

		<div id="paused" data-if="watching && w_paused && !menu_visible"><img src="icons/pause.png"/></div>

		<div id="watch-top" data-if="watching && info_visible && !menu_visible">
			<img class="watch-shade-top" src="images/shade_top.png"/>
			<div class="watch-title">{{w_title}}</div>
			<div class="watch-subtitle" data-if="w_subtitle != ''">{{w_subtitle}}</div>
		</div>

		<div id="watch-bar" data-if="watching && info_visible && !menu_visible">
			<img class="watch-shade" src="images/shade_v.png"/>
			<div class="watch-content">
				<div class="seek">
					<div class="seek-fill" data-style-width="w_progress"/>
					<div class="seek-knob" data-style-left="w_progress"/>
				</div>
				<div class="watch-times">
					<span class="watch-time">{{w_time}}</span>
					<span class="watch-duration" data-if="w_duration != ''">{{w_duration}}</span>
				</div>
				<div class="watch-tracks">{{w_tracks}}</div>
				<div class="watch-stats" data-if="w_stats != ''">{{w_stats}}</div>
				<div class="watch-hints">
					<span class="hint"><img class="key-icon" src="icons/cross.png"/>Pause</span>
					<span class="hint"><img class="key-icon" src="icons/dpad.png"/>Seek 10s</span>
					<span class="hint"><img class="key-icon" src="icons/l1.png"/><img class="key-icon" src="icons/r1.png"/>1 min</span>
					<span class="hint"><img class="key-icon" src="icons/square.png"/>Subtitles</span>
					<span class="hint"><img class="key-icon" src="icons/triangle.png"/>Audio</span>
					<span class="hint"><img class="key-icon" src="icons/options.png"/>Tracks</span>
					<span class="hint"><img class="key-icon" src="icons/circle.png"/>Stop</span>
				</div>
			</div>
		</div>

		<div id="track-menu" data-if="watching && menu_visible" data-class-shown="watching && menu_visible">
			<div class="menu-col" data-class-focused="m_col == 0">
				<div class="menu-head">Audio</div>
				<div id="menu-audio" class="menu-list">
					<div class="menu-item" data-for="m : m_audio"
					     data-class-selected="m_col == 0 && it_index == m_audio_sel"
					     data-class-active="m.active"><img class="menu-check" data-if="m.active" src="icons/check.png"/>{{m.label}}</div>
					<div class="menu-empty" data-if="m_audio.size == 0">No audio</div>
				</div>
			</div>
			<div class="menu-col" data-class-focused="m_col == 1">
				<div class="menu-head">Subtitles</div>
				<div id="menu-subs" class="menu-list">
					<div class="menu-item" data-for="m : m_subs"
					     data-class-selected="m_col == 1 && it_index == m_sub_sel"
					     data-class-active="m.active"><img class="menu-check" data-if="m.active" src="icons/check.png"/>{{m.label}}</div>
				</div>
				<div class="menu-delay">{{m_delay}}  (L2 / R2)</div>
			</div>
		</div>

		<!-- ======================= Overlays ======================= -->

		<div id="launch" data-if="launch_visible" data-class-shown="launch_visible">
			<img id="launch-bg" data-if="launch_image != ''" data-attr-src="launch_image"/>
			<div id="launch-box">
				<img class="launch-logo" src="icons/logo.png"/>
				<div class="launch-title">{{launch_title}}</div>
				<div class="launch-dots">
					<span class="busy-dot busy-dot1"/><span class="busy-dot busy-dot2"/><span class="busy-dot busy-dot3"/>
				</div>
				<div class="launch-status">{{launch_status}}</div>
				<div class="tstats" data-if="t_visible">
					<div class="tstats-title">Statistics</div>
					<div class="tstats-row">
						<div class="tstats-cell"><div class="tstats-label">Peers</div><div class="tstats-value">{{t_peers}}</div></div>
						<div class="tstats-cell"><div class="tstats-label">Speed</div><div class="tstats-value">{{t_speed}}</div></div>
						<div class="tstats-cell"><div class="tstats-label">Completed</div><div class="tstats-value">{{t_progress}}</div></div>
					</div>
					<div class="tstats-label">Info hash</div>
					<div class="tstats-hash">{{t_hash}}</div>
				</div>
				<div class="launch-hint"><img class="key-icon" src="icons/circle.png"/>Cancel</div>
			</div>
		</div>

		<div id="dropdown" data-if="dd_visible" data-class-shown="dd_visible">
			<div id="dropdown-box">
				<div class="dd-title">{{dd_title}}</div>
				<div id="dd-list" class="list">
					<div class="dd-item" data-for="o : dd_options"
					     data-class-selected="it_index == dd_sel"
					     data-class-active="o.active"><img class="menu-check" data-if="o.active" src="icons/check.png"/>{{o.label}}</div>
				</div>
			</div>
		</div>

		<div id="login" data-if="login_visible" data-class-shown="login_visible">
			<div id="login-box">
				<img class="login-logo" src="icons/logo.png"/>
				<div class="login-title">Log in to Stremio</div>
				<div class="login-body">
					<div class="login-qr-box">
						<img class="login-qr" data-if="login_qr != ''" data-attr-src="login_qr"/>
					</div>
					<div class="login-text">
						<div class="login-step">1. Scan the code with your phone, or open</div>
						<div class="login-link">{{login_link}}</div>
						<div class="login-step">2. Log in and approve this code:</div>
						<div class="login-code">{{login_code}}</div>
						<div class="login-status">{{login_status}}</div>
					</div>
				</div>
				<div class="login-hint"><img class="key-icon" src="icons/circle.png"/>Cancel</div>
			</div>
		</div>

		<div id="toast" data-if="toast != ''" data-class-shown="toast != ''">{{toast}}</div>

	</body>
</rml>
