/*
 * Player overlays, after Stremio's player: title at the top, seek bar and
 * times at the bottom, both over soft shading. kMenuPitch in
 * src/app_watch.cpp = .menu-item height + margin = 58 + 8.
 */

#watch-top {
	position: absolute;
	left: 0px;
	top: 0px;
	width: 1920px;
	height: 200px;
}

.watch-shade-top {
	position: absolute;
	left: 0px;
	top: 0px;
	width: 1920px;
	height: 200px;
}

.watch-title {
	position: relative;
	padding: 44dp 80dp 0px 80dp;
	font-size: 36dp;
	font-weight: bold;
	white-space: nowrap;
	overflow: hidden;
}

.watch-subtitle {
	position: relative;
	padding: 2dp 80dp 0px 80dp;
	font-size: 24dp;
	color: #ffffffb3;
	white-space: nowrap;
	overflow: hidden;
}

#watch-bar {
	position: absolute;
	left: 0px;
	top: 640px;
	width: 1920px;
	height: 440px;
}

.watch-shade {
	position: absolute;
	left: 0px;
	top: 0px;
	width: 1920px;
	height: 440px;
}

.watch-content {
	position: absolute;
	left: 80px;
	top: 150px;
	width: 1760px;
}

.seek {
	position: relative;
	height: 8dp;
	margin-bottom: 16dp;
	background-color: #ffffff40;
	border-radius: 4dp;
}

.seek-fill {
	height: 8dp;
	background-color: #7b5bf5;
	border-radius: 4dp;
}

.seek-knob {
	position: absolute;
	top: -8dp;
	width: 24dp;
	height: 24dp;
	margin-left: -12dp;
	background-color: #ffffff;
	border-radius: 12dp;
}

.watch-times {
	display: flex;
	flex-direction: row;
}

.watch-time {
	flex: 1;
	font-size: 24dp;
	font-weight: bold;
}

.watch-duration {
	font-size: 24dp;
	color: #ffffffb3;
}

.watch-tracks {
	margin-top: 10dp;
	font-size: 18dp;
	color: #ffffff99;
	white-space: nowrap;
	overflow: hidden;
}

.watch-stats {
	margin-top: 4dp;
	max-height: 48dp;
	font-size: 17dp;
	line-height: 24dp;
	color: #ffffff66;
	white-space: pre-line;
	overflow: hidden;
}

.watch-hints {
	margin-top: 16dp;
}

#paused {
	position: absolute;
	left: 870px;
	top: 450px;
	width: 180px;
	height: 180px;
	box-sizing: border-box;
	padding-top: 60dp;  /* centres the 80dp icon in the 180px circle */
	text-align: center;
	background-color: #00000080;
	border-radius: 90dp;
}

#paused img {
	width: 80dp;
	height: 80dp;
}

#buffering {
	position: absolute;
	left: 460px;
	top: 470px;
	width: 1000px;
	text-align: center;
}

.buffer-dots .busy-dot {
	width: 16px;
	height: 16px;
	margin: 0px 6px;
	decorator: image(../images/dot32.png);
}

.buffer-text {
	margin-top: 18dp;
	font-size: 24dp;
	font-weight: bold;
	color: #ffffffe6;
	font-effect: outline(2px #000000);
}

/* ------------------------------------------------------------------ */
/* Subtitles: white with a black outline, as Stremio draws them.      */
/* ------------------------------------------------------------------ */

#subtitles {
	position: absolute;
	left: 120px;
	width: 1680px;
	bottom: 80px;
	text-align: center;
}

#subtitles.raised {
	bottom: 360dp;
}

#subtitles .sub-text {
	display: inline-block;
	padding: 2dp 16dp;
	color: #ffffff;
	font-weight: bold;
	font-effect: outline(3px #000000);
}

#subtitles.sub-s .sub-text { font-size: 38px; line-height: 50px; }
#subtitles.sub-m .sub-text { font-size: 48px; line-height: 62px; }
#subtitles.sub-l .sub-text { font-size: 60px; line-height: 76px; }

/* ------------------------------------------------------------------ */
/* Track menu                                                         */
/* ------------------------------------------------------------------ */

#track-menu {
	position: absolute;
	left: 260px;
	top: 150px;
	width: 1400px;
	height: 760px;
	box-sizing: border-box;
	display: flex;
	flex-direction: row;
	padding: 34dp;
	background-color: #0f0d20f2;
	border: 1dp #ffffff14;
	border-radius: 26dp;
}

.menu-col {
	display: flex;
	flex-direction: column;
	flex: 1;
	margin: 0px 14dp;
	opacity: 0.55;
}

.menu-col.focused {
	opacity: 1;
}

.menu-head {
	height: 58dp;
	font-size: 30dp;
	font-weight: bold;
}

.menu-list {
	flex: 1;
	overflow-x: hidden;
	overflow-y: auto;
}
.menu-list scrollbarvertical {
	width: 6dp;
}
.menu-list scrollbarvertical sliderbar {
	background-color: #ffffff30;
	border-radius: 3dp;
}
.menu-list scrollbarvertical sliderarrowdec,
.menu-list scrollbarvertical sliderarrowinc {
	width: 0px;
	height: 0px;
}

.menu-item {
	box-sizing: border-box;
	height: 58dp;
	margin-bottom: 8dp;
	padding: 11dp 18dp 0px 52dp;
	font-size: 23dp;
	color: #ffffffb3;
	background-color: #ffffff08;
	border: 3dp transparent;
	border-radius: 14dp;
	white-space: nowrap;
	overflow: hidden;
	position: relative;
}

.menu-check {
	position: absolute;
	left: 14dp;
	top: 13dp;
	width: 26dp;
	height: 26dp;
	image-color: #7b5bf5;
}

.menu-item.active {
	color: #ffffff;
	font-weight: bold;
}

.menu-item.selected {
	background-color: #ffffff1a;
	border-color: #ffffff;
}

.menu-empty {
	font-size: 22dp;
	color: #ffffff66;
}

.menu-delay {
	margin-top: 14dp;
	font-size: 21dp;
	color: #ffffff99;
}
