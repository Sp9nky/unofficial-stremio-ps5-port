/*
 * Stremio 5's look on a 1920x1080 couch screen.
 *
 *   background   #0c0b11 with violet glows (images/bg.png)
 *   surfaces     white at 5-13% opacity over it
 *   text         white 90%, secondary 60%, faint 40%
 *   accent       #7b5bf5 (Stremio purple); watched #22b365
 *   focus        a white ring (the TV apps' focus style)
 *
 * The SDL software renderer draws flat colours, borders, rounded corners
 * and images; gradients come from pre-rendered images (tools/make_assets.py).
 */

body {
	width: 100%;
	height: 100%;
	font-family: Noto Sans;
	font-size: 24dp;
	color: #ffffffe6;
	background-color: #0c0b11;
}

/* While a video plays the body is transparent and the app is gone; only
   the player overlays remain above the picture. */
body.watching {
	background-color: transparent;
}
body.watching #app {
	display: none;
}

.hint {
	display: inline-block;
	margin-right: 30dp;
	font-size: 20dp;
	color: #ffffff99;
}

.key-icon {
	display: inline-block;
	width: 30dp;
	height: 30dp;
	vertical-align: -8dp;
	margin-right: 8dp;
}

/* Loading dots: anti-aliased images (tools/make_icons.sh) at a fixed pixel
   size, twice as large in the file so they scale down cleanly. Each fades
   in and out smoothly, a fifth of a second after the one before. */
.busy-dot {
	display: inline-block;
	width: 11px;
	height: 11px;
	margin: 0px 4px;
	decorator: image(../images/dot22.png);
	opacity: 0.25;
}
.busy-dot1 { animation: 0.6s 0.0s cubic-in-out infinite alternate busy-pulse; }
.busy-dot2 { animation: 0.6s 0.2s cubic-in-out infinite alternate busy-pulse; }
.busy-dot3 { animation: 0.6s 0.4s cubic-in-out infinite alternate busy-pulse; }

@keyframes busy-pulse {
	from { opacity: 0.25; }
	to   { opacity: 1; }
}

/* Lists scroll programmatically; their scrollbars are thin markers. */
.list {
	overflow-x: hidden;
	overflow-y: auto;
}
.list scrollbarvertical {
	width: 6dp;
}
.list scrollbarvertical slidertrack {
	background-color: #ffffff08;
}
.list scrollbarvertical sliderbar {
	background-color: #ffffff30;
	border-radius: 3dp;
}
.list scrollbarvertical sliderarrowdec,
.list scrollbarvertical sliderarrowinc {
	width: 0px;
	height: 0px;
}

/* Runtime · year · IMDb badge, on the detail page and in Discover. */
.meta-row {
	display: flex;
	flex-direction: row;
	align-items: center;
	margin-bottom: 22dp;
}

.meta-item {
	margin-right: 24dp;
	font-size: 22dp;
	font-weight: bold;
	color: #ffffffcc;
}

.imdb {
	font-size: 22dp;
	font-weight: bold;
	color: #ffffffcc;
}

.imdb-logo {
	margin-right: 10dp;
	padding: 1dp 8dp;
	font-size: 17dp;
	font-weight: bold;
	color: #000000;
	background-color: #f5c518;
	border-radius: 5dp;
}
