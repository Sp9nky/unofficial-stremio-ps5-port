/*
 * Board and search results: rows of posters.
 *
 * Mirrored in src/app.cpp:
 *   kCardPitch = .card width + margin-right       = 286 + 30 = 316
 *   kRowPitch  = .board-row height + margin-bottom = 520 + 20 = 540
 * Two rows fill the page (980px - padding = 2 x 540dp x kUiScale).
 * A strip is exactly six cards wide (6 x 316 - 30 = 1866) and scrolls by
 * whole cards (App::scroll_strip), so no poster is cut off.
 * Rows and cards start at offset 0 inside their scroll containers.
 */

.board {
	flex: 1;
	overflow-x: hidden;
	overflow-y: auto;
}
.board scrollbarvertical {
	width: 0px;
}

.board-row {
	box-sizing: border-box;
	height: 520dp;
	margin-bottom: 20dp;
}

.row-head {
	display: flex;
	flex-direction: row;
	align-items: center;
	width: 1866dp;
	height: 48dp;
	margin-bottom: 6dp;
}

.row-title {
	flex: 1;
	font-size: 28dp;
	font-weight: bold;
	color: #ffffffe6;
	white-space: nowrap;
	overflow: hidden;
}

.see-all {
	font-size: 17dp;
	font-weight: bold;
	letter-spacing: 2dp;
	color: #ffffff80;
}

.row-head.current .see-all {
	color: #ffffffcc;
}

.strip {
	display: flex;
	flex-direction: row;
	width: 1866dp;
	height: 466dp;
	overflow-x: auto;
	overflow-y: hidden;
}
.strip scrollbarhorizontal {
	height: 0px;
}

.card {
	box-sizing: border-box;
	flex: 0 0 286dp;
	width: 286dp;
	height: 466dp;
	margin-right: 30dp;
}

/* Board posters are larger: the picture is pre-scaled to 278x422
   (ArtKind::PosterLarge). */
.card .poster {
	width: 286dp;
	height: 430dp;
	border-radius: 18dp;
}
.card .poster-img,
.card .poster-ph {
	width: 278dp;
	height: 422dp;
}
.card .poster-ph {
	border-radius: 14dp;
}
.card .card-title {
	margin-top: 8dp;
	height: 28dp;
	line-height: 28dp;
}

/* Shared by board and grid cards. The picture is pre-scaled to exactly
   182x277 with rounded corners (see artcache), so it draws unscaled. */
.poster {
	position: relative;
	box-sizing: border-box;
	width: 190dp;
	height: 285dp;
	border: 4dp transparent;
	border-radius: 16dp;
}

.card.selected .poster,
.grid-card.selected .poster {
	border-color: #ffffff;
}

.poster-img {
	width: 182dp;
	height: 277dp;
}

.poster-ph {
	box-sizing: border-box;
	width: 182dp;
	height: 277dp;
	padding: 20dp 14dp;
	font-size: 21dp;
	font-weight: bold;
	color: #ffffff80;
	text-align: center;
	background-color: #ffffff10;
	border-radius: 12dp;
	overflow: hidden;
}

.poster-badge {
	position: absolute;
	left: 10dp;
	top: 10dp;
	padding: 2dp 10dp;
	font-size: 16dp;
	font-weight: bold;
	color: #ffffff;
	background-color: #000000b8;
	border-radius: 8dp;
}

.card-progress {
	position: absolute;
	left: 12dp;
	right: 12dp;
	bottom: 12dp;
	height: 6dp;
	background-color: #ffffff38;
	border-radius: 3dp;
}

.card-progress-bar {
	height: 6dp;
	background-color: #7b5bf5;
	border-radius: 3dp;
}

.card-title {
	margin-top: 10dp;
	height: 30dp;
	font-size: 20dp;
	line-height: 30dp;
	color: #ffffff99;
	white-space: nowrap;
	overflow: hidden;
}

.card.selected .card-title,
.grid-card.selected .card-title {
	color: #ffffff;
	font-weight: bold;
}

.row-message {
	padding-top: 20dp;
	font-size: 24dp;
	color: #ffffff66;
}
