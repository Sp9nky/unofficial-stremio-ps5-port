/* Full-screen overlays in Stremio's modal style: launching, dropdowns,
   sign-in, text entry, toast. kDropdownPitch in src/app_browse.cpp =
   .dd-item height + margin = 60 + 8. */

#launch {
	position: absolute;
	left: 0px;
	top: 0px;
	width: 1920px;
	height: 1080px;
	background-color: #0c0b11;
}

#launch-bg {
	position: absolute;
	left: 0px;
	top: 0px;
	width: 1920px;
	height: 1080px;
	image-color: #ffffff40;
}

#launch-box {
	position: absolute;
	left: 260px;
	top: 200px;
	width: 1400px;
	text-align: center;
}

#launch-box .launch-logo {
	width: 96dp;
	height: 96dp;
	margin-bottom: 30dp;
}

#launch-box .launch-title {
	font-size: 48dp;
	font-weight: bold;
	line-height: 60dp;
	max-height: 120dp;
	overflow: hidden;
}

#launch-box .launch-dots {
	margin-top: 34dp;
}

#launch-box .launch-status {
	margin-top: 22dp;
	font-size: 26dp;
	color: #ffffffcc;
}

#launch-box .launch-hint {
	margin-top: 40dp;
	font-size: 21dp;
	color: #ffffff99;
}

/* Torrent statistics, as in the PC app: peers, speed, completed, hash. */
.tstats {
	box-sizing: border-box;
	width: 620dp;
	margin: 36dp auto 0px auto;
	padding: 26dp 32dp;
	text-align: left;
	background-color: #14131ce6;
	border-radius: 18dp;
}

.tstats-title {
	margin-bottom: 18dp;
	font-size: 24dp;
	font-weight: bold;
	color: #ffffff;
}

.tstats-row {
	display: flex;
	flex-direction: row;
	margin-bottom: 14dp;
}

.tstats-cell {
	flex: 1;
}

.tstats-label {
	font-size: 20dp;
	color: #ffffff80;
}

.tstats-value {
	margin-top: 4dp;
	font-size: 24dp;
	font-weight: bold;
	color: #ffffff;
}

.tstats-hash {
	margin-top: 6dp;
	font-size: 19dp;
	color: #ffffffcc;
}

/* ------------------------------------------------------------------ */
/* Dropdown                                                           */
/* ------------------------------------------------------------------ */

#dropdown {
	position: absolute;
	left: 0px;
	top: 0px;
	width: 1920px;
	height: 1080px;
	background-color: #0c0b11b0;
}

#dropdown-box {
	position: absolute;
	left: 660px;
	top: 150px;
	width: 600px;
	height: 780px;
	box-sizing: border-box;
	display: flex;
	flex-direction: column;
	padding: 30dp 30dp 20dp 30dp;
	background-color: #0f0d20;
	border: 1dp #ffffff1c;
	border-radius: 26dp;
}

.dd-title {
	height: 60dp;
	font-size: 30dp;
	font-weight: bold;
}

#dd-list {
	flex: 1;
}

.dd-item {
	box-sizing: border-box;
	position: relative;
	height: 60dp;
	margin-bottom: 8dp;
	padding: 12dp 18dp 0px 54dp;
	font-size: 23dp;
	color: #ffffffb3;
	background-color: #ffffff08;
	border: 3dp transparent;
	border-radius: 14dp;
	white-space: nowrap;
	overflow: hidden;
}

.dd-item.active {
	color: #ffffff;
	font-weight: bold;
}

.dd-item.selected {
	background-color: #ffffff1a;
	border-color: #ffffff;
}

/* ------------------------------------------------------------------ */
/* Sign-in                                                            */
/* ------------------------------------------------------------------ */

#login {
	position: absolute;
	left: 0px;
	top: 0px;
	width: 1920px;
	height: 1080px;
	background-color: #0c0b11f0;
}

#login-box {
	position: absolute;
	left: 260px;
	top: 160px;
	width: 1400px;
	height: 760px;
	box-sizing: border-box;
	padding: 44dp 56dp;
	background-color: #0f0d20;
	border: 1dp #ffffff1c;
	border-radius: 28dp;
}

.login-logo {
	width: 72dp;
	height: 72dp;
	margin-bottom: 16dp;
}

.login-title {
	margin-bottom: 36dp;
	font-size: 42dp;
	font-weight: bold;
}

.login-body {
	display: flex;
	flex-direction: row;
}

.login-qr-box {
	width: 420dp;
	height: 420dp;
	margin-right: 56dp;
	background-color: #ffffff;
	border-radius: 18dp;
}

.login-qr {
	width: 400dp;
	height: 400dp;
	margin: 10dp;
}

.login-text {
	flex: 1;
}

.login-step {
	margin-bottom: 10dp;
	font-size: 25dp;
	color: #ffffffb3;
}

.login-link {
	margin-bottom: 40dp;
	font-size: 30dp;
	font-weight: bold;
	color: #a58bff;
}

.login-code {
	margin-bottom: 30dp;
	font-size: 96dp;
	font-weight: bold;
	letter-spacing: 16dp;
}

.login-status {
	font-size: 21dp;
	color: #ffffff99;
}

.login-hint {
	position: absolute;
	left: 56dp;
	bottom: 36dp;
	font-size: 21dp;
	color: #ffffff99;
}

/* ------------------------------------------------------------------ */
/* Text entry                                                         */
/* ------------------------------------------------------------------ */

#input {
	position: absolute;
	left: 0px;
	top: 0px;
	width: 1920px;
	height: 1080px;
	background-color: #0c0b11c0;
}

#input-box {
	position: absolute;
	left: 360px;
	top: 120px;
	width: 1200px;
	box-sizing: border-box;
	padding: 34dp 44dp;
	background-color: #0f0d20;
	border: 3dp #7b5bf5;
	border-radius: 24dp;
}

.input-title {
	margin-bottom: 18dp;
	font-size: 26dp;
	color: #ffffffb3;
}

.input-value {
	min-height: 56dp;
	font-size: 40dp;
	font-weight: bold;
	white-space: nowrap;
	overflow: hidden;
}

.input-caret {
	color: #7b5bf5;
}

.input-hint {
	margin-top: 16dp;
	font-size: 20dp;
	color: #ffffff66;
}

/* On-screen keyboard: 4 rows of 12 keys, then 4 wide keys. */
.osk {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	width: 1092dp;
	margin-top: 24dp;
}

.osk-key {
	box-sizing: border-box;
	width: 85dp;
	height: 64dp;
	margin: 0px 6dp 6dp 0px;
	padding-top: 13dp;
	font-size: 26dp;
	font-weight: bold;
	text-align: center;
	color: #ffffffcc;
	background-color: #ffffff10;
	border: 3dp transparent;
	border-radius: 12dp;
}

.osk-key.wide {
	width: 267dp;
	padding-top: 16dp;
	font-size: 22dp;
}

.osk-key.selected {
	color: #ffffff;
	background-color: #7b5bf5;
	border-color: #ffffff;
}

.osk-hints {
	margin-top: 18dp;
}

/* ------------------------------------------------------------------ */
/* Toast                                                              */
/* ------------------------------------------------------------------ */

#toast {
	position: absolute;
	left: 460px;
	bottom: 110px;
	width: 1000px;
	box-sizing: border-box;
	padding: 20dp 30dp;
	font-size: 24dp;
	text-align: center;
	color: #ffffffe6;
	background-color: #0f0d20f2;
	border: 2dp #7b5bf5;
	border-radius: 18dp;
}
