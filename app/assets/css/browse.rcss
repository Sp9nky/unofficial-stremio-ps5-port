/*
 * Discover, Library, Addons.
 *
 * Mirrored in src/app_browse.cpp and src/app.h:
 *   kGridRowPitch = .grid-card height + margin-bottom = 352 + 24 = 376
 *   5 columns in .grid-5, 7 in .grid-7: card width + margin = 214 each
 *   kAddonPitch   = .addon-tile height + margin = 400 + 24 = 424 (4 per row)
 */

.filters {
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 76dp;
	margin-bottom: 14dp;
}

.filter-chip {
	box-sizing: border-box;
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 58dp;
	margin-right: 16dp;
	padding: 0px 20dp 0px 26dp;
	background-color: #ffffff12;
	border: 3dp transparent;
	border-radius: 29dp;
}

.filter-chip.selected {
	background-color: #ffffff22;
	border-color: #ffffff;
}

.filter-value {
	margin-right: 12dp;
	font-size: 22dp;
	font-weight: bold;
	white-space: nowrap;
}

.filter-caret {
	width: 22dp;
	height: 22dp;
	image-color: #ffffff99;
}

/* ------------------------------------------------------------------ */
/* Grids                                                              */
/* ------------------------------------------------------------------ */

.discover-body {
	display: flex;
	flex-direction: row;
	height: 980dp;
}

/* Discover: Board-sized posters (ArtKind::PosterLarge), four to a row, two
   whole rows on screen: kDiscRowPitch = 466 + 24 = 490, grid 2 x 490. */
#disc-grid {
	width: 1270dp;  /* a few dp more than 4 x (286 + 30) */
	height: 980dp;
}
#disc-grid .grid-card {
	width: 286dp;
	height: 466dp;
	margin: 0px 30dp 24dp 0px;
}
#disc-grid .poster {
	width: 286dp;
	height: 430dp;
	border-radius: 18dp;
}
#disc-grid .poster-img,
#disc-grid .poster-ph {
	width: 278dp;
	height: 422dp;
}
#disc-grid .card-title {
	margin-top: 8dp;
	height: 28dp;
	line-height: 28dp;
}

.grid {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	align-content: flex-start;
	height: 870px;  /* fills the page; not scaled */
	overflow-x: hidden;
	overflow-y: auto;
}
.grid scrollbarvertical {
	width: 0px;
}

/* A few pixels more than N cards need, so exactly N fit per row. */
.grid-5 {
	width: 1080dp;
}
.grid-7 {
	width: 1510dp;
}

.grid-card {
	box-sizing: border-box;
	width: 190dp;
	height: 352dp;
	margin: 0px 24dp 24dp 0px;
}

/* ------------------------------------------------------------------ */
/* Discover preview                                                   */
/* ------------------------------------------------------------------ */

/* A card beside the grid: the title's artwork, its logo fitted in a fixed
   box (both pre-scaled to exactly these sizes, ArtKind::Still / LogoBox),
   then the details. */
.preview {
	box-sizing: border-box;
	width: 700dp;
	height: 956dp;
	padding: 24dp;
	background-color: #ffffff0a;
	border-radius: 26dp;
	overflow: hidden;
}

.preview-still {
	display: block;
	width: 652dp;
	height: 367dp;
	margin-bottom: 26dp;
}

.preview-still-ph {
	background-color: #ffffff0d;
	border-radius: 16dp;
}

.preview-logo {
	display: block;
	width: 560dp;
	height: 120dp;
	margin-bottom: 22dp;
}

.preview-name {
	margin-bottom: 20dp;
	font-size: 40dp;
	font-weight: bold;
	line-height: 50dp;
	max-height: 100dp;
	overflow: hidden;
}

.preview .meta-row {
	margin-bottom: 14dp;
}

.preview-genres {
	margin-bottom: 16dp;
	font-size: 20dp;
	color: #a58bff;
	font-weight: bold;
}

.preview-desc {
	max-height: 186dp;  /* six lines */
	font-size: 20dp;
	line-height: 31dp;
	color: #ffffffb3;
	overflow: hidden;
}

.preview-hint {
	margin-top: 22dp;
	font-size: 20dp;
	color: #ffffff99;
}

/* ------------------------------------------------------------------ */
/* Addons                                                             */
/* ------------------------------------------------------------------ */

/* Tiles, four to a row (kAddonCols), two rows on screen:
   kAddonPitch = .addon-tile height + margin-bottom = 400 + 24 = 424. */
#addon-list {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	align-content: flex-start;
	/* The whole page width: the 6dp scrollbar + 4 x (462 + 24) = 1950,
	   with a few dp to spare so rounding never wraps the fourth tile. */
	width: 1956dp;
	height: 848dp;
}

.addon-tile {
	box-sizing: border-box;
	width: 462dp;
	height: 400dp;
	margin: 0px 24dp 24dp 0px;
	padding: 28dp 30dp;
	background-color: #ffffff0d;
	border: 3dp transparent;
	border-radius: 24dp;
	overflow: hidden;
}

.addon-tile.selected {
	background-color: #ffffff1a;
	border-color: #ffffff;
}

.addon-top {
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 96dp;
	margin-bottom: 22dp;
}

/* The picture is pre-scaled to exactly this size (ArtKind::Icon). */
.addon-logo {
	width: 96dp;
	height: 96dp;
	margin-right: 22dp;
}

.addon-logo-ph {
	box-sizing: border-box;
	padding-top: 22dp;
	font-size: 40dp;
	line-height: 52dp;
	font-weight: bold;
	text-align: center;
	color: #ffffffcc;
	background-color: #7b5bf5;
	border-radius: 18dp;
}

.addon-head {
	flex: 1;
	overflow: hidden;
}

.addon-name {
	font-size: 27dp;
	font-weight: bold;
	line-height: 36dp;
	max-height: 72dp;
	overflow: hidden;
}

.addon-version {
	margin-top: 4dp;
	font-size: 17dp;
	color: #ffffff80;
	white-space: nowrap;
}

.addon-local {
	margin-left: 12dp;
	padding: 1dp 8dp;
	font-size: 13dp;
	font-weight: bold;
	letter-spacing: 1dp;
	color: #ffffffcc;
	background-color: #ffffff1f;
	border-radius: 6dp;
}

.addon-types {
	margin-bottom: 12dp;
	font-size: 17dp;
	font-weight: bold;
	color: #a58bff;
	white-space: nowrap;
	overflow: hidden;
}

.addon-desc {
	font-size: 18dp;
	line-height: 27dp;
	max-height: 135dp;  /* five lines */
	color: #ffffff99;
	overflow: hidden;
}
