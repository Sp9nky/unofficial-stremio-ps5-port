/* Frame: background, left navigation, top bar, the page area. */

#app {
	position: absolute;
	left: 0px;
	top: 0px;
	width: 1920px;
	height: 1080px;
}

#app-bg {
	position: absolute;
	left: 0px;
	top: 0px;
	width: 1920px;
	height: 1080px;
}

/* ------------------------------------------------------------------ */
/* Left navigation                                                    */
/* ------------------------------------------------------------------ */

#nav {
	position: absolute;
	left: 0px;
	top: 0px;
	width: 120px;
	height: 1080px;
	display: flex;
	flex-direction: column;
	justify-content: center;
}

/* The items sit centred on the screen's height; the logo at the bottom.
   logo.png is rendered at exactly 60dp x kUiScale = 54px (make_icons.sh). */
.nav-logo {
	position: absolute;
	left: 0px;
	bottom: 0px;
	width: 120px;
	height: 100dp;
	text-align: center;
}

.nav-logo img {
	width: 60dp;
	height: 60dp;
	margin-top: 10dp;
}

.nav-item {
	box-sizing: border-box;
	width: 100dp;
	height: 100dp;
	margin: 6dp 10dp;
	padding-top: 16dp;
	text-align: center;
	border: 3dp transparent;
	border-radius: 20dp;
}

.nav-item img {
	width: 42dp;
	height: 42dp;
	image-color: #ffffff66;
}

.nav-label {
	margin-top: 4dp;
	font-size: 16dp;
	color: #ffffff66;
}

/* Outline icons; the solid one for the page you're on and the highlighted
   item, as Stremio's own menu does. */
.nav-item img.nav-s {
	display: none;
}
.nav-item.active img.nav-o,
.nav-item.selected img.nav-o {
	display: none;
}
.nav-item.active img.nav-s,
.nav-item.selected img.nav-s {
	display: inline-block;
}

.nav-item.active {
	background-color: #ffffff12;
}
.nav-item.active img {
	image-color: #ffffff;
}
.nav-item.active .nav-label {
	color: #ffffff;
}

.nav-item.selected {
	background-color: #7b5bf5;
	border-color: #ffffff;
}
.nav-item.selected img {
	image-color: #ffffff;
}
.nav-item.selected .nav-label {
	color: #ffffff;
}

/* ------------------------------------------------------------------ */
/* Top bar                                                            */
/* ------------------------------------------------------------------ */

#topbar {
	position: absolute;
	left: 120px;
	top: 0px;
	width: 1800px;
	height: 100px;
	box-sizing: border-box;
	display: flex;
	flex-direction: row;
	align-items: center;
	padding: 0px 56dp 0px 40dp;
}

/* The pill is a pre-rendered, anti-aliased image at exactly this size
   (tools/make_icons.sh): CSS rounded borders come out jagged here. */
#searchbar {
	box-sizing: border-box;
	display: flex;
	flex-direction: row;
	align-items: center;
	width: 560dp;
	height: 50dp;
	margin-right: 30dp;
	padding: 0px 20dp 0px 24dp;
	decorator: image(../images/searchbar.png);
}

#searchbar.selected {
	decorator: image(../images/searchbar_sel.png);
}

#searchbar .search-placeholder {
	flex: 1;
	font-size: 19dp;
	color: #ffffff66;
	white-space: nowrap;
}

#searchbar .search-text {
	flex: 1;
	font-size: 19dp;
	font-weight: bold;
	white-space: nowrap;
	overflow: hidden;
}

#searchbar .search-icon {
	width: 24dp;
	height: 24dp;
	image-color: #ffffff99;
}

#searchbar.selected .search-icon {
	image-color: #ffffff;
}

.topbar-spacer {
	flex: 1;
}

.topbar-busy {
	margin-right: 22dp;
}

.topbar-clock {
	font-size: 26dp;
	font-weight: bold;
	color: #ffffffcc;
}

/* ------------------------------------------------------------------ */
/* Page area                                                          */
/* ------------------------------------------------------------------ */

.page {
	position: absolute;
	left: 120px;
	top: 100px;
	width: 1800px;
	height: 980px;
	box-sizing: border-box;
	display: flex;
	flex-direction: column;
	padding: 8dp 0px 0px 20dp;
}

.page-title {
	height: 76dp;
	font-size: 40dp;
	font-weight: bold;
}

.page-heading {
	height: 44dp;
	font-size: 22dp;
	color: #ffffff99;
}

.page-empty {
	width: 100%;
	padding-top: 40dp;
	font-size: 26dp;
	color: #ffffff66;
}

.page-footer {
	height: 76dp;
	display: flex;
	flex-direction: row;
	align-items: center;
}

.banner {
	box-sizing: border-box;
	margin: 0px 60dp 24dp 0px;
	padding: 18dp 26dp;
	font-size: 23dp;
	color: #ffffffe6;
	background-color: #7b5bf540;
	border: 2dp #7b5bf5;
	border-radius: 16dp;
}
