/*
 * Detail page, after Stremio's: the title's artwork behind, its details on
 * the left, episodes or streams in a panel on the right.
 *
 * Mirrored in src/app_detail.cpp:
 *   kEpisodePitch = .episode-row height + margin = 112 + 12 = 124
 *   kStreamPitch  = .stream-row height + margin  = 124 + 12 = 136
 */

#detail {
	position: absolute;
	left: 0px;
	top: 0px;
	width: 1920px;
	height: 1080px;
	background-color: #0c0b11;
}

#detail-bg {
	position: absolute;
	left: 0px;
	top: 0px;
	width: 1920px;
	height: 1080px;
	/* A full-resolution, softly blurred copy (ArtKind::Backdrop). */
	image-color: #ffffffff;
}

#detail-shade {
	position: absolute;
	left: 0px;
	top: 0px;
	width: 1920px;
	height: 1080px;
}

#detail-info {
	position: absolute;
	left: 110px;
	top: 80px;
	width: 860px;
}

#detail-logo {
	height: 150dp;
	margin-bottom: 30dp;
}

#detail-name {
	margin-bottom: 24dp;
	font-size: 64dp;
	font-weight: bold;
	line-height: 76dp;
	max-height: 230dp;
	overflow: hidden;
}

.detail-section {
	margin-bottom: 22dp;
}

.section-label {
	margin-bottom: 6dp;
	font-size: 17dp;
	font-weight: bold;
	letter-spacing: 2dp;
	color: #ffffff80;
}

.section-value {
	font-size: 22dp;
	color: #ffffffd9;
}

.section-desc {
	max-height: 272dp;
	font-size: 22dp;
	line-height: 34dp;
	color: #ffffffd9;
	overflow: hidden;
}

.detail-resume {
	display: inline-block;
	margin-top: 8dp;
	padding: 10dp 22dp;
	font-size: 22dp;
	font-weight: bold;
	color: #ffffff;
	background-color: #7b5bf5;
	border-radius: 12dp;
}

.detail-resume img {
	width: 22dp;
	height: 22dp;
	margin-right: 10dp;
	vertical-align: -3dp;
}

/* ------------------------------------------------------------------ */
/* Right panel                                                        */
/* ------------------------------------------------------------------ */

/* Sized to its content so there's no empty space and no half-shown row:
   season bar 80 + seven episodes (7 x kEpisodePitch = 868) = 948, or a
   head 66 + six streams (6 x kStreamPitch = 816) + a status line 66. Lists
   are a whole number of rows tall and scroll by whole rows. */
#detail-panel {
	position: absolute;
	right: 60px;
	top: 97px;  /* centred: (1080 - 984dp x kUiScale) / 2 */
	width: 720px;
	box-sizing: border-box;
	padding: 24dp 24dp 12dp 24dp;
	background-color: #14112ac8;
	border-radius: 24dp;
}

.panel-body {
	display: flex;
	flex-direction: column;
	height: 948dp;
}

#season-bar {
	box-sizing: border-box;
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 64dp;
	margin-bottom: 16dp;
	padding: 0px 18dp;
	background-color: #ffffff0d;
	border: 3dp transparent;
	border-radius: 18dp;
}

#season-bar.focused {
	background-color: #ffffff1a;
	border-color: #ffffff;
}

.season-arrow {
	width: 28dp;
	height: 28dp;
	image-color: #ffffffb3;
}

.season-label {
	flex: 1;
	font-size: 24dp;
	font-weight: bold;
	text-align: center;
}

#episode-list {
	height: 868dp;
}

.episode-row {
	box-sizing: border-box;
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 112dp;
	margin-bottom: 12dp;
	padding: 0px 18dp 0px 8dp;
	background-color: #ffffff08;
	border: 3dp transparent;
	border-radius: 18dp;
}

.episode-row.selected {
	background-color: #ffffff1a;
	border-color: #ffffff;
}

.episode-thumb {
	width: 160dp;
	height: 90dp;
	margin-right: 18dp;
	background-color: #ffffff10;
	border-radius: 10dp;
	overflow: hidden;
}

.episode-thumb img {
	width: 160dp;
	height: 90dp;
}

.episode-text {
	flex: 1;
	overflow: hidden;
}

.episode-title {
	font-size: 22dp;
	font-weight: bold;
	white-space: nowrap;
	overflow: hidden;
}

.episode-row.watched .episode-title {
	color: #ffffff99;
}

.episode-sub {
	margin-top: 4dp;
	font-size: 17dp;
	color: #ffffff80;
	white-space: nowrap;
	overflow: hidden;
}

.episode-check {
	width: 28dp;
	height: 28dp;
	margin-left: 10dp;
	image-color: #22b365;
}

.panel-head {
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 56dp;
	margin-bottom: 10dp;
}

.panel-back {
	width: 28dp;
	height: 28dp;
	margin-right: 12dp;
	image-color: #ffffffb3;
}

.panel-title {
	font-size: 26dp;
	font-weight: bold;
	white-space: nowrap;
	overflow: hidden;
}

#stream-list {
	height: 816dp;
}

.stream-row {
	box-sizing: border-box;
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 124dp;
	margin-bottom: 12dp;
	padding: 12dp 18dp;
	background-color: #ffffff0a;
	border: 3dp transparent;
	border-radius: 18dp;
	overflow: hidden;
}

.stream-row.selected {
	background-color: #ffffff1f;
	border-color: #ffffff;
}

.stream-left {
	width: 170dp;
	margin-right: 18dp;
	overflow: hidden;
}

.stream-name {
	max-height: 52dp;
	font-size: 20dp;
	font-weight: bold;
	line-height: 26dp;
	white-space: pre-line;
	overflow: hidden;
}

.stream-addon {
	margin-top: 4dp;
	font-size: 15dp;
	color: #ffffff80;
	white-space: nowrap;
	overflow: hidden;
}

.stream-desc {
	flex: 1;
	max-height: 92dp;
	font-size: 17dp;
	line-height: 23dp;
	color: #ffffffcc;
	white-space: pre-line;
	overflow: hidden;
}

.stream-play {
	width: 30dp;
	height: 30dp;
	margin-left: 12dp;
	image-color: #ffffff00;
}

.stream-row.selected .stream-play {
	image-color: #ffffff;
}

.panel-status {
	padding: 14dp 6dp;
	font-size: 21dp;
	color: #ffffff99;
}

.panel-empty {
	padding: 30dp 6dp;
	font-size: 22dp;
	color: #ffffff66;
}

.detail-footer {
	position: absolute;
	left: 110px;
	bottom: 30px;
}
