/*
 * Motion: selection highlights ease in and out, overlays fade in.
 *
 * Only colours and opacity are animated. The PS5 build draws on the CPU and
 * its renderer has no transforms, so there is no scaling or sliding; lists
 * and rows glide to the selection in code instead (App::glide).
 * Linked last, so it can adjust the rules of the other stylesheets.
 */

/* Borders fade from transparent white (not through black). */
.stream-row, .episode-row, .setting-row, .addon-tile, .filter-chip, #season-bar,
.dd-item, .menu-item, .nav-item, .poster {
	border-color: #ffffff00;
}

.stream-row, .episode-row, .setting-row, .addon-tile, .filter-chip, #season-bar,
.dd-item, .menu-item, .nav-item {
	transition: background-color border-color color 0.18s cubic-out;
}

.poster {
	transition: border-color 0.18s cubic-out;
}

.card-title, .nav-label, .setting-hint, .see-all {
	transition: color 0.18s cubic-out;
}

.nav-item img, .stream-play {
	transition: image-color 0.18s cubic-out;
}

.menu-col {
	transition: opacity 0.2s cubic-out;
}

/* Overlays fade in each time they appear (the "shown" class is bound to
   the same condition as their data-if, so it is added anew every time). */
@keyframes fade-in {
	from { opacity: 0; }
	to { opacity: 1; }
}

#launch.shown, #dropdown.shown, #login.shown, #input.shown, #track-menu.shown {
	animation: 0.22s cubic-out fade-in;
}

#toast.shown {
	animation: 0.3s cubic-out fade-in;
}
