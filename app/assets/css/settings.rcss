/*
 * Settings. kSettingPitch in src/app_settings.cpp = height + margin = 92 + 12.
 */

#settings-list {
	height: 860px;
	margin-right: 60dp;
}

.setting-row {
	box-sizing: border-box;
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 92dp;
	margin-bottom: 12dp;
	padding: 0px 28dp;
	background-color: #ffffff0d;
	border: 3dp transparent;
	border-radius: 18dp;
	overflow: hidden;
}

.setting-row.selected {
	background-color: #ffffff1a;
	border-color: #ffffff;
}

.setting-main {
	flex: 1;
	overflow: hidden;
}

.setting-label {
	font-size: 24dp;
	font-weight: bold;
	white-space: nowrap;
}

.setting-hint {
	margin-top: 2dp;
	font-size: 17dp;
	color: #ffffff66;
	white-space: nowrap;
	overflow: hidden;
}

.setting-row.selected .setting-hint {
	color: #ffffff99;
}

.setting-value {
	max-width: 760dp;
	margin-left: 24dp;
	font-size: 21dp;
	color: #a58bff;
	text-align: right;
	white-space: nowrap;
	overflow: hidden;
}
